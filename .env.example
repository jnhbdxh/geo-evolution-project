NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://geo_os_app:geo_os_app@127.0.0.1:5432/geo_os
DATABASE_MIGRATION_URL=postgresql://geo_os_migrator:geo_os_migrator@127.0.0.1:5432/geo_os
OUTBOX_DATABASE_URL=postgresql://geo_os_outbox_dispatcher:geo_os_outbox_dispatcher@127.0.0.1:5432/geo_os
OUTBOX_DATABASE_POOL_MAX=2
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_STATEMENT_TIMEOUT_MS=5000
OUTBOX_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
OUTBOX_QUEUE_NAME=geo-os-domain-events
QUERY_EXECUTION_QUEUE_NAME=geo-os-query-executions
OUTBOX_REDIS_STARTUP_TIMEOUT_MS=5000
OUTBOX_REDIS_COMMAND_TIMEOUT_MS=3000
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_ERROR_DELAY_MS=1000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_RETRY_DELAY_MS=1000
OUTBOX_MAX_RETRY_DELAY_MS=300000
JWT_SECRET=replace-with-at-least-32-characters
INTERNAL_SERVICE_TOKEN_SECRET=replace-with-a-distinct-32-character-secret
QUERY_ENGINE_WORKER_TOKEN=replace-with-a-distinct-worker-secret-at-least-32-characters
AUTH_MODE=development

# Provider-neutral evidence storage. Local development uses MinIO.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=geo_os_minio
OBJECT_STORAGE_SECRET_KEY=geo_os_minio_secret
OBJECT_STORAGE_BUCKET=geo-os-evidence

# Production must use Tencent Cloud COS. The bucket is pre-created and includes APPID.
# OBJECT_STORAGE_PROVIDER=cos
# OBJECT_STORAGE_BUCKET=geo-os-evidence-1250000000
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=replace-with-cam-secret-id
# COS_SECRET_KEY=replace-with-cam-secret-key
# COS_SESSION_TOKEN=optional-temporary-session-token

# Database integration tests use the isolated Compose service on port 5433.
# TEST_DATABASE_URL=postgresql://geo_os_app:geo_os_app@127.0.0.1:5433/geo_os_test
# TEST_OUTBOX_DATABASE_URL=postgresql://geo_os_outbox_dispatcher:geo_os_outbox_dispatcher@127.0.0.1:5433/geo_os_test
# TEST_DATABASE_MIGRATION_URL=postgresql://geo_os_migrator:geo_os_migrator@127.0.0.1:5433/geo_os_test
# ALLOW_DATABASE_INTEGRATION_TESTS=true

# BullMQ integration tests use the isolated Redis service on port 6380.
# TEST_REDIS_URL=redis://127.0.0.1:6380
# ALLOW_REDIS_INTEGRATION_TESTS=true

# Capture integration tests use the isolated MinIO service on port 9100.
# TEST_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
# TEST_OBJECT_STORAGE_ACCESS_KEY=geo_os_minio_test
# TEST_OBJECT_STORAGE_SECRET_KEY=geo_os_minio_test_secret
# ALLOW_OBJECT_STORAGE_INTEGRATION_TESTS=true

# Real Doubao Web execution uses Playwright UI automation, never a model API.
# Keep StorageState outside the repository; production must supply it from encrypted secrets.
# DOUBAO_STORAGE_STATE_PATH=D:/secure-runtime/doubao/storage-state.json
# CORE_API_BASE_URL=http://127.0.0.1:3000
# QUERY_ENGINE_IDENTITY_ID=authorized-doubao-identity
# DOUBAO_ENTRY_URL=https://www.doubao.com/chat/
# QUERY_ENGINE_HEADLESS=false
# QUERY_ENGINE_BROWSER_EXECUTABLE_PATH=C:/path/to/controlled/chromium.exe
# DOUBAO_INTERACTIVE_VERIFICATION_TIMEOUT_MS=0
# ALLOW_REAL_AI_TESTS=true
# DOUBAO_TEST_PROMPT=请只回答：联调成功
# QUERY_ENGINE_SMOKE_OUTPUT_DIR=.codex-tmp/query-engine-smoke/doubao
