NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://geo_os_app:geo_os_app@127.0.0.1:5432/geo_os
DATABASE_MIGRATION_URL=postgresql://geo_os_migrator:geo_os_migrator@127.0.0.1:5432/geo_os
JWT_SECRET=replace-with-at-least-32-characters
INTERNAL_SERVICE_TOKEN_SECRET=replace-with-a-distinct-32-character-secret
AUTH_MODE=development

# Provider-neutral evidence storage. Local development uses MinIO.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=geo_os_minio
OBJECT_STORAGE_SECRET_KEY=geo_os_minio_secret
OBJECT_STORAGE_BUCKET=geo-os-evidence

# Production must use Tencent Cloud COS. The bucket is pre-created and includes APPID.
# OBJECT_STORAGE_PROVIDER=cos
# OBJECT_STORAGE_BUCKET=geo-os-evidence-1250000000
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=replace-with-cam-secret-id
# COS_SECRET_KEY=replace-with-cam-secret-key
# COS_SESSION_TOKEN=optional-temporary-session-token

# Database integration tests use the isolated Compose service on port 5433.
# TEST_DATABASE_URL=postgresql://geo_os_app:geo_os_app@127.0.0.1:5433/geo_os_test
# TEST_DATABASE_MIGRATION_URL=postgresql://geo_os_migrator:geo_os_migrator@127.0.0.1:5433/geo_os_test
# ALLOW_DATABASE_INTEGRATION_TESTS=true

# Capture integration tests use the isolated MinIO service on port 9100.
# TEST_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
# TEST_OBJECT_STORAGE_ACCESS_KEY=geo_os_minio_test
# TEST_OBJECT_STORAGE_SECRET_KEY=geo_os_minio_test_secret
# ALLOW_OBJECT_STORAGE_INTEGRATION_TESTS=true
